{
  "name": "fizzim-vscode",
  "displayName": "Fizzim FSM Editor",
  "description": "Draw finite state machines and generate synthesizable Verilog/VHDL — a native VS Code editor for Fizzim (.fzm) diagrams.",
  "version": "2.0.6",
  "publisher": "CaioPlazas",
  "license": "GPL-3.0-or-later",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#3b3fb0",
    "theme": "dark"
  },
  "keywords": [
    "fsm",
    "finite state machine",
    "verilog",
    "vhdl",
    "fizzim",
    "hdl",
    "fpga",
    "rtl",
    "state diagram"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/CaioPlazas/fizzim-vscode.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "fizzim.editor",
        "displayName": "Fizzim FSM Editor",
        "selector": [
          {
            "filenamePattern": "*.fzm"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "fizzim.newDiagram",
        "title": "New Diagram",
        "category": "Fizzim"
      },
      {
        "command": "fizzim.generateHdl",
        "title": "Generate HDL…",
        "category": "Fizzim",
        "icon": "$(zap)"
      },
      {
        "command": "fizzim.exportImage",
        "title": "Export as Image…",
        "category": "Fizzim",
        "icon": "$(device-camera)"
      },
      {
        "command": "fizzim.globalAttributes",
        "title": "Global Attributes…",
        "category": "Fizzim",
        "icon": "$(table)"
      },
      {
        "command": "fizzim.zoomIn",
        "title": "Zoom In",
        "category": "Fizzim"
      },
      {
        "command": "fizzim.zoomOut",
        "title": "Zoom Out",
        "category": "Fizzim"
      },
      {
        "command": "fizzim.zoomReset",
        "title": "Reset Zoom (100%)",
        "category": "Fizzim"
      },
      {
        "command": "fizzim.zoomFit",
        "title": "Fit to Window",
        "category": "Fizzim",
        "icon": "$(screen-normal)"
      },
      {
        "command": "fizzim.fitPage",
        "title": "Fit Page to Drawing",
        "category": "Fizzim"
      },
      {
        "command": "fizzim.toggleGrid",
        "title": "Toggle Grid",
        "category": "Fizzim"
      },
      {
        "command": "fizzim.toggleTable",
        "title": "Toggle Global Table",
        "category": "Fizzim"
      },
      {
        "command": "fizzim.toggleCanvasSurface",
        "title": "Toggle Canvas Surface (Paper / Theme)",
        "category": "Fizzim"
      },
      {
        "command": "fizzim.preferences",
        "title": "Diagram Preferences…",
        "category": "Fizzim"
      },
      {
        "command": "fizzim.pageSetup",
        "title": "Page Setup…",
        "category": "Fizzim"
      },
      {
        "command": "fizzim.viewAsText",
        "title": "View/Edit as Text",
        "category": "Fizzim"
      },
      {
        "command": "fizzim.about",
        "title": "About Fizzim for VS Code",
        "category": "Fizzim"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "comment": "Generate/Globals/Export deliberately do NOT live here: the title bar is a screen away from the canvas you're working on, and VS Code folds these into a '…' overflow once the tab bar fills up. They're buttons in the webview toolbar instead. What's left is the low-traffic stuff, which is fine behind the overflow.",
          "command": "fizzim.viewAsText",
          "when": "activeCustomEditorId == 'fizzim.editor'",
          "group": "1_fizzim"
        },
        {
          "command": "fizzim.pageSetup",
          "when": "activeCustomEditorId == 'fizzim.editor'",
          "group": "1_fizzim"
        },
        {
          "command": "fizzim.preferences",
          "when": "activeCustomEditorId == 'fizzim.editor'",
          "group": "1_fizzim"
        }
      ],
      "commandPalette": [
        {
          "command": "fizzim.generateHdl",
          "when": "activeCustomEditorId == 'fizzim.editor'"
        },
        {
          "command": "fizzim.exportImage",
          "when": "activeCustomEditorId == 'fizzim.editor'"
        },
        {
          "command": "fizzim.globalAttributes",
          "when": "activeCustomEditorId == 'fizzim.editor'"
        },
        {
          "command": "fizzim.zoomIn",
          "when": "activeCustomEditorId == 'fizzim.editor'"
        },
        {
          "command": "fizzim.zoomOut",
          "when": "activeCustomEditorId == 'fizzim.editor'"
        },
        {
          "command": "fizzim.zoomReset",
          "when": "activeCustomEditorId == 'fizzim.editor'"
        },
        {
          "command": "fizzim.zoomFit",
          "when": "activeCustomEditorId == 'fizzim.editor'"
        },
        {
          "command": "fizzim.fitPage",
          "when": "activeCustomEditorId == 'fizzim.editor'"
        },
        {
          "command": "fizzim.toggleGrid",
          "when": "activeCustomEditorId == 'fizzim.editor'"
        },
        {
          "command": "fizzim.toggleTable",
          "when": "activeCustomEditorId == 'fizzim.editor'"
        },
        {
          "command": "fizzim.toggleCanvasSurface",
          "when": "activeCustomEditorId == 'fizzim.editor'"
        },
        {
          "command": "fizzim.preferences",
          "when": "activeCustomEditorId == 'fizzim.editor'"
        },
        {
          "command": "fizzim.pageSetup",
          "when": "activeCustomEditorId == 'fizzim.editor'"
        },
        {
          "command": "fizzim.viewAsText",
          "when": "activeCustomEditorId == 'fizzim.editor'"
        },
        {
          "command": "fizzim.about",
          "when": "activeCustomEditorId == 'fizzim.editor'"
        }
      ]
    },
    "keybindings": [
      {
        "command": "fizzim.zoomIn",
        "key": "ctrl+=",
        "mac": "cmd+=",
        "when": "activeCustomEditorId == 'fizzim.editor'"
      },
      {
        "command": "fizzim.zoomOut",
        "key": "ctrl+-",
        "mac": "cmd+-",
        "when": "activeCustomEditorId == 'fizzim.editor'"
      },
      {
        "command": "fizzim.zoomReset",
        "key": "ctrl+numpad0",
        "mac": "cmd+numpad0",
        "when": "activeCustomEditorId == 'fizzim.editor'"
      }
    ],
    "configuration": {
      "title": "Fizzim",
      "properties": {
        "fizzim.perlPath": {
          "type": "string",
          "default": "perl",
          "description": "Path to the Perl interpreter used to run the code generator."
        },
        "fizzim.scriptPath": {
          "type": "string",
          "default": "",
          "description": "Optional override for the Fizzim HDL code generator (fizzim.pl). Leave empty to use the copy bundled with the extension. It is invoked as `perl <scriptPath> -language <language>` with the .fzm fed on stdin (Perl must be installed)."
        },
        "fizzim.language": {
          "type": "string",
          "enum": [
            "verilog",
            "vhdl",
            "systemverilog"
          ],
          "default": "verilog",
          "description": "Target HDL language for 'Generate HDL'."
        },
        "fizzim.canvasSurface": {
          "type": "string",
          "enum": [
            "paper",
            "theme"
          ],
          "enumDescriptions": [
            "White background with black ink, regardless of the VS Code theme — the standard look for FSM diagrams, and what exported images always use.",
            "Follow the colors of the active VS Code theme."
          ],
          "default": "paper",
          "description": "Background the diagram canvas is drawn on. Exported PNG/JPEG images are always 'paper', whichever mode you work in. Also toggleable from the editor's View menu."
        },
        "fizzim.editBarExpanded": {
          "type": "boolean",
          "default": false,
          "description": "Keep the edit bar expanded to multiple rows (pinned) instead of a single paged row. Also toggled by the chevron on the edit bar itself."
        },
        "fizzim.darkMode": {
          "type": "boolean",
          "default": false,
          "deprecationMessage": "Superseded by fizzim.canvasSurface. A `true` value is migrated to `fizzim.canvasSurface: \"theme\"` automatically.",
          "description": "Deprecated: use fizzim.canvasSurface instead."
        },
        "fizzim.defaultStateColor": {
          "type": "string",
          "default": "#000000",
          "description": "Default color (hex) for newly created states. Also editable from the Preferences dialog."
        },
        "fizzim.defaultTransitionColor": {
          "type": "string",
          "default": "#000000",
          "description": "Default color (hex) for newly created state transitions. Also editable from the Preferences dialog."
        },
        "fizzim.defaultLoopbackColor": {
          "type": "string",
          "default": "#000000",
          "description": "Default color (hex) for newly created loopback transitions. Also editable from the Preferences dialog."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run build:icons && npm run build:extension && npm run build:webview",
    "build:icons": "node scripts/copy-codicons.mjs",
    "build:extension": "esbuild src/extension.ts --bundle --platform=node --external:vscode --outfile=dist/extension.js --minify",
    "build:webview": "esbuild src/webview/main.ts --bundle --platform=browser --outfile=dist/webview.js --minify",
    "watch": "esbuild src/extension.ts --bundle --platform=node --external:vscode --outfile=dist/extension.js --watch & esbuild src/webview/main.ts --bundle --platform=browser --outfile=dist/webview.js --watch",
    "test": "node --test --require ts-node/register src/fzm/*.test.ts src/webview/*.test.ts",
    "golden": "node --require ts-node/register scripts/golden.ts",
    "package": "npx --yes @vscode/vsce package --no-dependencies -o fizzim-vscode-demo.vsix"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.85.0",
    "@vscode/codicons": "^0.0.36",
    "esbuild": "^0.24.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  },
  "bugs": {
    "url": "https://github.com/CaioPlazas/fizzim-vscode/issues"
  },
  "homepage": "https://github.com/CaioPlazas/fizzim-vscode#readme"
}
